/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class BSTIterator {
private: stack<TreeNode*>myStack;
public:
    BSTIterator(TreeNode* root) {
        pushAll(root); // Pushing all nodes to the left of current node
    }
    
    int next() { // returns the next node (node on the right (in inorder traversal) of current node)
        TreeNode* node = myStack.top();
        myStack.pop();
        pushAll(node->right); // pushing all left nodes to the left of the next node's right
        return node->val;
    }
    
    bool hasNext() { // Basically tells whether next node exists - if stack is empty then no, if not then yes it exists
        if(myStack.empty()){
            return false;
        }
        return true;
    }
private: void pushAll(TreeNode* node){ // Function to push all the left nodes to the current node into the stack
    while(node){
        myStack.push(node);
        node = node->left;
    }
}
};

