/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    TreeNode* prev;
    TreeNode* first;
    TreeNode* last;
    void recoverTree(TreeNode* root) {
        if(root == NULL)return;
        first = last = NULL;
        TreeNode* lastEncNode; // Using this are the current node in our Morris Traversal
        prev = new TreeNode(INT_MIN);
        TreeNode* cur = root;
        while(cur){
            if(cur->left == NULL){
                // push - instead of pushing like usual we assign the value to our lastEncNode
                lastEncNode = cur;
                if(prev->val > lastEncNode->val){ // Then we perform the same checks which we did in our Better solution
                    if(first == NULL && last == NULL){
                        first = prev;
                        last = lastEncNode;
                    }
                    else{
                        last = lastEncNode;
                    }
                }
                prev = lastEncNode;
                // Move cur to right
                cur = cur->right;
            }
            else{
                TreeNode* prevMorris = cur->left;
                while(prevMorris->right && prevMorris->right != cur){
                    prevMorris = prevMorris->right;
                }
                if(prevMorris->right == NULL){
                    // Make thread
                    prevMorris->right = cur;
                    // Move cur to left
                    cur = cur->left;
                }
                else{
                    // Remove thread
                    prevMorris->right = NULL;
                    // push - instead of pushing like usual we assign the value to our lastEncNode
                    lastEncNode = cur;
                    if(prev->val > lastEncNode->val){
                        if(first == NULL && last == NULL){
                            first = prev;
                            last = lastEncNode;
                        }
                        else{
                            last = lastEncNode;
                        }
                    }
                    prev = lastEncNode;
                    // Move cur to right
                    cur = cur->right;
                }
            }
        }
        swap(first->val,last->val);
    }
};
