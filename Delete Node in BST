/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    TreeNode* findRight(TreeNode* root){
        if(root->right == NULL)return root;
        return findRight(root->right);
    }
    TreeNode* helper(TreeNode* root){ // Target node is found, this function helps delete and resolve the left/right subtree acc to BST and returns it
        if(root->left == NULL)return root->right;
        else if(root->right == NULL)return root->left;
        TreeNode* rightMost = findRight(root->left);
        rightMost->right = root->right;
        return root->left;
    }
    TreeNode* deleteNode(TreeNode* root, int key) { // Searching for target node
        if(root == NULL)return NULL;
        TreeNode* cur = root;
        if(root->val == key){
            return helper(root);
        }
        while(root != NULL){
            if(key < root->val){
                if(root->left != NULL && root->left->val == key){
                    root->left = helper(root->left); // Helper resolves the left subtree of root and returns the subtree after removing the target node
                    break;
                }
                root = root->left; // else we move left in search of target node
            }
            else{
                if(root->right != NULL && root->right->val == key){
                    root->right = helper(root->right);
                    break;
                }
                root = root->right;
            }
        }
        return cur;
    }
};
