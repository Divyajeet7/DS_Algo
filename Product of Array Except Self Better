class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        int n = nums.size();
        vector<int>ans(n);
        vector<int>prefix(n);
        vector<int>suffix(n);
        int prod = 1;
        for(int i=0;i<nums.size();i++){ // Initializing vector with prefix products for each element
            prefix[i] = prod;
            prod *= nums[i];
        }
        prod = 1;
        for(int i=n-1;i>=0;i--){ // Initializing vector with suffix products for each element
            suffix[i] = prod;
            prod *= nums[i];
        }
        for(int i=0;i<n;i++){
            ans[i] = prefix[i]*suffix[i]; // Product of array except self for each element is basically product of prefix products and suffix products
        }
        return ans;
    }
};
