    // OPTIMAL
    bool isValidBST(TreeNode* root) {
        // USING MORRIS TRAVERSAL
        long long lastVal = LLONG_MIN;
        TreeNode* cur = root;
        bool isValid = true;
        while(cur != NULL){
            if(cur->left == NULL){
                if(cur->val <= lastVal)isValid = false;
                lastVal = cur->val;
                cur = cur->right;
            }
            else{
                TreeNode* prev = cur->left;
                while(prev->right != NULL && prev->right != cur)prev = prev->right;
                if(prev->right == NULL){
                    prev->right = cur;
                    cur = cur->left;
                }
                else{
                    prev->right = NULL;
                    if(cur->val <= lastVal)isValid = false;
                    lastVal = cur->val;
                    cur = cur->right;
                }
            }
        }
        return isValid;
    }
