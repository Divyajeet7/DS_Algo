class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        int n = nums.size();
        vector<int>ans(n);
        ans[0] = 1;
        for(int i=1;i<nums.size();i++){ // Initilizing vector with prefix products
            ans[i] = ans[i-1] * nums[i-1];
        }
        int prod = 1;
        for(int i=n-1;i>=0;i--){ // Multiplying prefix products to suffix products for each index
            ans[i] = ans[i] * prod;
            prod *= nums[i];
        }
        return ans;
    }
};
