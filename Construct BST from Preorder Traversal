/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    TreeNode* bstFromPreorder(vector<int>& preorder) {
        int i = 0;
        return build(preorder, i, INT_MAX);
    }
    TreeNode* build(vector<int>&A, int &i, int bound){
        if(i == A.size() || A[i] > bound)return NULL; // If we have already traversed preorder vector or current element is out of bounds we cannot create a node here hence we return NULL.
        TreeNode* root = new TreeNode(A[i++]);
        root->left = build(A, i, root->val); // For left subtree upperbound is current node->val
        root->right = build(A, i, bound); // For right subtree upperbound is current nodes upper bound
        return root;
    }
};
